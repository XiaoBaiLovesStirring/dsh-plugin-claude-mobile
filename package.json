{
  "name": "dsh-plugin-claude-mobile",
  "version": "1.0.0",
  "description": "Claude 风格的手机版布局优化 + 竖列设置面板 —— DeepSeek Harness (dsh) 插件",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.1.0-rc.6"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "claude",
    "mobile",
    "responsive"
  ],
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "external": [],
      "immediately": false
    }
  }
}
